# Server
PORT=3000

# JWT — change this to a long random string in production
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# OpenAI — required for AI-powered search
OPENAI_API_KEY=sk-...

# Supabase — paste your Session Pooler URI from Connect → Session Pooler
DATABASE_URL=postgresql://postgres.YOURREF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# CORS — comma-separated list of allowed frontend origins
# Leave blank for localhost only, set to your deployed frontend URL in production
CORS_ORIGIN=https://your-frontend.vercel.app
